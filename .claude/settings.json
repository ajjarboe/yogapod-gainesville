{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { yarn lint --fix && yarn typecheck; } 1>&2 || exit 2",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
